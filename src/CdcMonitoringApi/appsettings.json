{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=cdc_monitoring;Username=cdc_user;Password=cdc_password_dev"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cdc-monitor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "Jwt": {
    "Issuer": "CdcMonitoringApi",
    "Audience": "CdcMonitoringApi",
    "Key": "this-is-a-dev-only-secret-key-for-cdc-monitoring-api-do-not-use-in-production-12345"
  },

  "AllowedHosts": "*"
}
